# Modelo do arquivo .env (este modelo vai para o GitHub; o .env de verdade NÃO vai).
# Para usar: copie este arquivo com o nome ".env" e troque os valores.

# Chave que assina o login e os links dos e-mails (gere com:
#   python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria

# Gmail que envia os e-mails do CampusHub e a "senha de app" de 16 letras gerada no Google
EMAIL_USUARIO=campushub.notices@gmail.com
EMAIL_SENHA_APP=abcdefghijklmnop

# Endereço do site (usado nos links dos e-mails)
SITE_URL=https://mycampushub.pythonanywhere.com
